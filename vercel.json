{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "celygrowth.com" }],
      "destination": "https://www.celygrowth.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
