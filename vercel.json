{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "celygrowth.com"
        }
      ],
      "destination": "https://www.celygrowth.com/:path",
      "statusCode": 301
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "2celygrowth.vercel.app"
        }
      ],
      "destination": "https://www.celygrowth.com/:path",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/actualites/gabarit",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/actualites/audit-avant-campagnes",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/actualites/geo-2026",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/actualites/linkedin-outbound",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/actualites/priorisation-growth",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/actualites/attribution-multicanal",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/cely.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/cely",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/cely-logo-light.png",
      "destination": "/images/cely-logo-light.png",
      "statusCode": 301
    },
    {
      "source": "/cely-logo-light.webp",
      "destination": "/images/cely-logo-light.webp",
      "statusCode": 301
    },
    {
      "source": "/cely-logo-dark.png",
      "destination": "/images/cely-logo-hd.png",
      "statusCode": 301
    },
    {
      "source": "/cely-mark-ce.png",
      "destination": "/images/cely-mark-ce.png",
      "statusCode": 301
    },
    {
      "source": "/celien-boillot.png",
      "destination": "/images/celien-boillot.png",
      "statusCode": 301
    },
    {
      "source": "/og-inbound-vs-outbound.png",
      "destination": "/images/og-inbound-vs-outbound.png",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/images/v/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
