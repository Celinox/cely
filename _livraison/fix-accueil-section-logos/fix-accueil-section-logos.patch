 /* ---------- clients : logos qui défilent (animation reprise de wenoble.fr : défilement linéaire 30 s, pause au survol, fondu sur les bords) ---------- */
-.hp-clients{ position:relative; padding-block:clamp(64px,7vw,96px) clamp(8px,2vw,24px); background:var(--off-white); }
-.hp-clients-head{ text-align:center; }
