+/* même respiration que les autres sections : le haut dégage le bandeau incliné (valeur reprise de .hp-video), la vidéo qui suit retrouve l'écart standard */
+.hp-clients{ position:relative; padding-block:clamp(112px,12vw,160px) 0; background:var(--off-white); }
+.hp-clients + .hp-video{ padding-top:calc(var(--hp-sec-y) * .75); }
+.hp-clients .hp-h2{ max-width:26ch; }
+.hp-clients-sub{ margin:14px 0 0; font-family:var(--font-label); font-size:.92rem; font-weight:600; color:var(--muted); }
+/* la bande : un seul bloc qui contient les logos et la carte, pour qu'ils se lisent ensemble */
+.hp-clients-row{ margin:clamp(32px,4vw,48px) auto 0; max-width:1040px; display:flex; align-items:stretch; border:var(--hp-line); border-radius:var(--hp-r); background:var(--white); box-shadow:var(--hp-sh); overflow:hidden; }
+.hp-clients-marquee{ position:relative; flex:1; min-width:0; display:flex; align-items:center; overflow:hidden; mask-image:linear-gradient(to right, transparent 0, #000 72px, #000 calc(100% - 72px), transparent 100%); -webkit-mask-image:linear-gradient(to right, transparent 0, #000 72px, #000 calc(100% - 72px), transparent 100%); }
+.hp-clients-track{ flex:none; display:flex; align-items:center; gap:64px; padding:0 32px; margin:0; list-style:none; animation:hpClientsScroll 30s linear infinite; }
 .hp-clients-marquee:hover .hp-clients-track{ animation-play-state:paused; }
