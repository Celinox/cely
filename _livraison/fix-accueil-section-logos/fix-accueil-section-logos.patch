-.hp-clients-track img{ display:block; width:auto; height:var(--lh,32px); max-width:none; opacity:.55; transition:opacity .2s; }
+.hp-clients-track li{ flex:none; display:flex; align-items:center; justify-content:center; height:84px; }
+.hp-clients-track img{ display:block; width:auto; height:var(--lh,32px); max-width:none; opacity:.6; transition:opacity .2s; }
 .hp-clients-track li:hover img{ opacity:1; }
 @keyframes hpClientsScroll{ from{ transform:translateX(0); } to{ transform:translateX(-100%); } }
-.hp-clients-next{ position:relative; flex:none; display:flex; align-items:center; gap:12px; padding:12px 18px 12px 12px; border:var(--hp-line); border-radius:var(--hp-r-sm); background:var(--white); box-shadow:var(--hp-sh); color:var(--prune); transition:transform .2s var(--ease-cely-out), box-shadow .2s var(--ease-cely-out); }
-.hp-clients-next:hover{ transform:translate(-2px,-2px); box-shadow:8px 8px 0 var(--violet-3); }
-.hp-clients-next:focus-visible{ outline:2.5px solid var(--violet-3); outline-offset:3px; }
-.hp-clients-cely-wrap{ position:relative; flex:none; width:64px; height:56px; border-radius:12px; background:var(--lavender); }
-.hp-clients-cely{ position:absolute; left:2px; bottom:0; width:60px; height:51px; }
+.hp-clients-next{ position:relative; flex:none; display:flex; align-items:center; gap:10px; padding:10px 18px 10px 12px; border-left:2px dashed rgba(26,17,40,.22); background:var(--lavender); color:var(--prune); transition:background .2s var(--ease-cely-out); }
