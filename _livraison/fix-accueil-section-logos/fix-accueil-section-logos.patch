-.hp-clients-sub{ margin:6px 0 0; font-family:var(--font-label); font-size:.9rem; font-weight:600; color:var(--muted); }
-.hp-clients-row{ margin-top:clamp(26px,3vw,40px); display:flex; align-items:center; gap:clamp(16px,2vw,28px); }
-.hp-clients-marquee{ position:relative; flex:1; min-width:0; display:flex; overflow:hidden; mask-image:linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%); -webkit-mask-image:linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%); }
